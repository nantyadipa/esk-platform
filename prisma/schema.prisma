generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Course {
  id               String          @id @default(uuid())
  name             String
  description      String          @db.Text
  basePrice        Decimal         @db.Decimal(10, 0)
  discountRate     Decimal         @default(0) @db.Decimal(3, 2)
  numberOfSessions Int
  modeAvailable    ModeAvailable   @default(both)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  students  Student[]         @relation("CourseStudents")
  schedules Schedule[]
}

model Student {
  id              String        @id @default(uuid())
  name            String
  phone           String
  selectedCourseId String?
  mode            StudentMode   @default(online)
  referralCode    String?
  status          StudentStatus @default(aktif)
  notes           String?       @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  selectedCourse Course?       @relation("CourseStudents", fields: [selectedCourseId], references: [id])
  schedules      ScheduleStudent[]
}

model Schedule {
  id             String       @id @default(uuid())
  courseId       String
  date           DateTime
  startTime      DateTime
  endTime        DateTime
  meetingNumber  Int
  zoomLink       String?
  mode           ScheduleMode @default(online)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  course      Course             @relation(fields: [courseId], references: [id])
  students    ScheduleStudent[]
}

model ScheduleStudent {
  id         String   @id @default(uuid())
  scheduleId String
  studentId  String

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, studentId])
}

model Content {
  id          String       @id @default(uuid())
  section     String
  contentType ContentType @default(rich_text)
  content     String       @db.Text
  imageUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash  String
  role          AdminRole @default(admin)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WhatsAppConfig {
  id              String   @id @default(uuid())
  adminPhone      String
  messageTemplate String   @db.Text
  updatedAt       DateTime @updatedAt
}

enum ModeAvailable {
  online
  offline
  both
}

enum StudentMode {
  online
  offline
}

enum StudentStatus {
  aktif
  tidak_aktif
  trial
}

enum ScheduleMode {
  online
  offline
}

enum ContentType {
  text
  rich_text
  json
}

enum AdminRole {
  admin
}